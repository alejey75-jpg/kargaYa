# ============================================================
# KargaYa API — Variables de entorno
# Copia este archivo como .env y llena los valores reales
# NUNCA subas .env al repositorio (ya está en .gitignore)
# ============================================================

# ── SERVIDOR ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── POSTGRESQL ────────────────────────────────────────────────
# Formato: postgresql://usuario:contraseña@host:puerto/base_de_datos
DB_URL=postgresql://kargaya_user:kargaya_pass@localhost:5432/kargaya_db

# Alternativa con variables separadas (si usas Railway, Supabase, etc.)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kargaya_db
DB_USER=kargaya_user
DB_PASSWORD=kargaya_pass
DB_SSL=false           # true en producción (Railway, Render, Heroku)
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── JWT (autenticación) ───────────────────────────────────────
# Genera un secret seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRET_SEGURO_DE_64_CARACTERES
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── WOMPI (pagos — fase 2) ────────────────────────────────────
# WOMPI_PUBLIC_KEY=pub_test_xxxxx
# WOMPI_PRIVATE_KEY=prv_test_xxxxx
# WOMPI_EVENTS_SECRET=xxxxx

# ── FIREBASE (notificaciones push) ───────────────────────────
# FIREBASE_PROJECT_ID=kargaya-app
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@kargaya-app.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# ── REDIS (cache y real-time) — fase 2 ───────────────────────
# REDIS_URL=redis://localhost:6379

# ── LOGGING ──────────────────────────────────────────────────
LOG_LEVEL=info    # debug | info | warn | error
